# ═══════════════════════════════════════════════════════════
# PropFirmTracker Bot — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── TELEGRAM (Required) ──────────────────────────────────
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Channel IDs (create 2 channels, add bot as admin, get IDs via @userinfobot)
FREE_CHANNEL_ID=-100XXXXXXXXXX
PREMIUM_CHANNEL_ID=-100XXXXXXXXXX

# Your Telegram user ID (for admin commands)
ADMIN_USER_IDS=123456789

# ── AI SUMMARIZER (Optional but recommended) ─────────────
# Get your key at https://console.anthropic.com
# Uses Claude Haiku = ~$2-5/month
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# ── PAYMENTS (Optional) ──────────────────────────────────
# Stripe (for card payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Crypto wallet for USDT payments
CRYPTO_WALLET=YOUR_USDT_TRC20_ADDRESS

# ── DATABASE ─────────────────────────────────────────────
DATABASE_PATH=data/propfirm_tracker.db

# ── LOGGING ──────────────────────────────────────────────
LOG_LEVEL=INFO
